# Copy to .env (same folder) and fill in from Supabase: Project Settings -> API.
# EXPO_PUBLIC_ values are built into the app, so use ONLY the anon (public) key,
# never the service_role key. The tables are protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
